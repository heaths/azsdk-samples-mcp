{
  "name": "azsdk-samples-mcp",
  "description": "Discovers and retrieves code samples from Azure SDK packages in Rust, .NET, Python, Go, Java, and Node.js projects.",
  "version": "0.4.1",
  "author": {
    "name": "Heath Stewart",
    "url": "https://github.com/heaths"
  },
  "homepage": "https://github.com/heaths/azsdk-samples-mcp",
  "repository": "https://github.com/heaths/azsdk-samples-mcp",
  "license": "MIT",
  "keywords": ["azure", "sdk", "samples", "mcp"],
  "mcpServers": {
    "azsdk-samples": {
      "type": "stdio",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/src/AzureSdk.SamplesMcp/AzureSdk.SamplesMcp.csproj",
        "--configuration",
        "Release",
        "--"
      ]
    }
  }
}
